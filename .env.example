# Public identity of this Gate (appears in every request and receipt)
GATE_ID=gate.example.com
# WebAuthn relying party id: the bare host name approvers open (no scheme, no port)
GATE_RP_ID=gate.example.com
# Exact origin approvers' browsers see (scheme + host [+ port]). HTTPS required except on localhost.
GATE_ORIGIN=https://gate.example.com
# Display name shown by the passkey prompt during enrolment
GATE_RP_NAME=Perathos Gate

# Server Ed25519 signing key: EITHER a 64-hex seed in GATE_SIGNING_KEY (preferred for PaaS) ...
# GATE_SIGNING_KEY=
# ... OR a key file created by `perathos-gate init`
GATE_KEY_FILE=./data/gate_signing.key

# SQLite by default; set a Postgres URL in production (pip install "perathos-gate[postgres]")
DATABASE_URL=sqlite:///./data/gate.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/gate

# Web Push notifications (optional). Generate with `perathos-gate vapid-keygen`; unset = push off.
# GATE_VAPID_PRIVATE_KEY=
# GATE_VAPID_SUBJECT=mailto:you@example.com

# Set to 1 behind a reverse proxy (Railway/Render/Fly) so rate limiting sees the real client IP
GATE_TRUST_PROXY=0
# Approver POSTs allowed per IP per minute on /a/* and /enroll/*
GATE_RATE_LIMIT_PER_MIN=30
